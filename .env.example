# Poker Pro Analytics - Environment Configuration
# Copie este arquivo para `.env.local` e preencha com suas credenciais reais

# Supabase Configuration
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# API Endpoints (se houver backend)
VITE_API_URL=http://localhost:3000

# Ambiente
VITE_ENV=development

# ⚠️ IMPORTANTE: Nunca commitar arquivo .env com valores reais!
# Use .env.local para desenvolvimento local
# Use secrets/environment variables em produção
